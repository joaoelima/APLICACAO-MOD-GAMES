<Window x:Class="GameTrainer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Trainer" Height="820" Width="1180"
        MinHeight="640" MinWidth="900"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0E1114" BorderBrush="#252A2F" BorderThickness="0,0,1,0">
            <DockPanel Margin="18">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="GAME TRAINER" FontSize="20" FontWeight="Bold" Margin="0,4,0,26" />
                    <Button Content="Biblioteca" Height="42" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="14,0" />
                    <Button Content="Crimson Desert" Height="42" HorizontalContentAlignment="Left" Padding="14,0" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="v0.1.0 • Protótipo" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="34,30,34,50">
                <Grid Margin="0,0,0,26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Crimson Desert" FontSize="30" FontWeight="Bold" />
                        <TextBlock x:Name="GameStatusText" Text="Aguardando o jogo..." Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#14382F" CornerRadius="12" Padding="14,8" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusBadge" Text="DESCONECTADO" Foreground="#68E3C7" FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <ItemsControl x:Name="SectionsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Margin="0,0,0,18" Padding="22">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />
                                    <ItemsControl ItemsSource="{Binding Features}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="220" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="Pronto para mapear" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
