<Window x:Class="GameTrainer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Trainer" Height="900" Width="1180"
        MinHeight="700" MinWidth="900"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="TrainerToggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="ToggleBorder"
                                Width="92" Height="34"
                                CornerRadius="17"
                                Background="#1C2126"
                                BorderBrush="#2C333A"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="OffText" Grid.Column="0" Text="OFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#B1B7BD" FontSize="11" FontWeight="Bold" />
                                <TextBlock x:Name="OnText" Grid.Column="1" Text="ON"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#646B72" FontSize="11" FontWeight="Bold" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#14382F" />
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#2E8B76" />
                                <Setter TargetName="OffText" Property="Foreground" Value="#527068" />
                                <Setter TargetName="OnText" Property="Foreground" Value="#68E3C7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DiagnosticButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#171C20" />
            <Setter Property="BorderBrush" Value="#2B333A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0E1114" BorderBrush="#252A2F" BorderThickness="0,0,1,0">
            <DockPanel Margin="18">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="GAME TRAINER" FontSize="20" FontWeight="Bold" Margin="0,4,0,26" />
                    <Button Content="Biblioteca" Height="42" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="14,0" />
                    <Button Content="Crimson Desert" Height="42" HorizontalContentAlignment="Left" Padding="14,0" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="v0.2.7 • Memory Discovery" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="34,30,34,50">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Crimson Desert" FontSize="30" FontWeight="Bold" />
                        <TextBlock x:Name="GameStatusText" Text="Aguardando o jogo..." Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#14382F" CornerRadius="12" Padding="14,8" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusBadge" Text="DESCONECTADO" Foreground="#68E3C7" FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <Border Background="#101418" BorderBrush="#252C32" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <TextBlock x:Name="TrainerStatusText"
                               Text="A interface abre primeiro; a análise de memória roda em segundo plano."
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12" TextWrapping="Wrap" />
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Button Content="Reanalisar memória"
                            Style="{StaticResource DiagnosticButton}"
                            Click="Reprobe_Click"
                            Margin="0,0,10,0" />
                    <Button Content="Copiar diagnóstico"
                            Style="{StaticResource DiagnosticButton}"
                            Click="CopyDiagnostic_Click" />
                </StackPanel>

                <Border Background="#11171B" BorderBrush="#2E3A40" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,22">
                    <StackPanel>
                        <TextBlock Text="Descoberta de memória" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Modo somente-leitura para descobrir Vida, Vigor e Espírito pela mudança real dos valores durante o jogo."
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,14" />

                        <Border Background="#0E1316" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                            <TextBlock x:Name="DiscoveryStatusText"
                                       Text="Clique em Iniciar mapeamento. O aplicativo capturará a memória base para Vida."
                                       Foreground="#D7DDE2" FontSize="12" TextWrapping="Wrap" />
                        </Border>

                        <WrapPanel>
                            <Button x:Name="StartDiscoveryButton"
                                    Content="1. Iniciar mapeamento"
                                    Style="{StaticResource DiagnosticButton}"
                                    Click="StartDiscovery_Click"
                                    Margin="0,0,10,10" />
                            <Button x:Name="RecordHealthButton"
                                    Content="2. Registrar perda de Vida"
                                    Style="{StaticResource DiagnosticButton}"
                                    Click="RecordHealth_Click"
                                    IsEnabled="False"
                                    Margin="0,0,10,10" />
                            <Button x:Name="RecordStaminaButton"
                                    Content="3. Registrar gasto de Vigor"
                                    Style="{StaticResource DiagnosticButton}"
                                    Click="RecordStamina_Click"
                                    IsEnabled="False"
                                    Margin="0,0,10,10" />
                            <Button x:Name="RecordSpiritButton"
                                    Content="4. Registrar gasto de Espírito"
                                    Style="{StaticResource DiagnosticButton}"
                                    Click="RecordSpirit_Click"
                                    IsEnabled="False"
                                    Margin="0,0,10,10" />
                            <Button x:Name="FinishDiscoveryButton"
                                    Content="5. Finalizar análise e copiar log"
                                    Style="{StaticResource DiagnosticButton}"
                                    Click="FinishDiscovery_Click"
                                    IsEnabled="False"
                                    Margin="0,0,10,10" />
                        </WrapPanel>

                        <TextBlock Text="Fluxo: iniciar → perder Vida → registrar → correr/gastar Vigor → registrar → gastar Espírito → registrar → finalizar."
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <ItemsControl x:Name="SectionsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Margin="0,0,0,18" Padding="22">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />
                                    <ItemsControl ItemsSource="{Binding Features}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="120" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedTextBrush}"
                                                                   FontSize="11" Margin="0,3,20,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1"
                                                              Style="{StaticResource TrainerToggle}"
                                                              HorizontalAlignment="Right"
                                                              VerticalAlignment="Center"
                                                              Tag="{Binding Id}"
                                                              IsEnabled="{Binding IsAvailable}"
                                                              Checked="FeatureToggle_Checked"
                                                              Unchecked="FeatureToggle_Unchecked" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
