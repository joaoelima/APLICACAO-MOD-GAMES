<Window x:Class="GameTrainer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Trainer" Height="820" Width="1180"
        MinHeight="640" MinWidth="900"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="TrainerToggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="ToggleBorder" Width="92" Height="34" CornerRadius="17"
                                Background="#1C2126" BorderBrush="#2C333A" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="OffText" Grid.Column="0" Text="OFF" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#B1B7BD" FontSize="11" FontWeight="Bold"/>
                                <TextBlock x:Name="OnText" Grid.Column="1" Text="ON" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#646B72" FontSize="11" FontWeight="Bold"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#14382F"/>
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#2E8B76"/>
                                <Setter TargetName="OffText" Property="Foreground" Value="#527068"/>
                                <Setter TargetName="OnText" Property="Foreground" Value="#68E3C7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ToggleBorder" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DiagnosticButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#171C20"/>
            <Setter Property="BorderBrush" Value="#2B333A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#0E1114" BorderBrush="#252A2F" BorderThickness="0,0,1,0">
            <DockPanel Margin="18">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="GAME TRAINER" FontSize="20" FontWeight="Bold" Margin="0,4,0,26"/>
                    <Button Content="Biblioteca" Height="42" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="14,0"/>
                    <Button Content="Crimson Desert" Height="42" HorizontalContentAlignment="Left" Padding="14,0"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="v0.2.2 • Dynamic Stats Probe" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="34,30,34,50">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Crimson Desert" FontSize="30" FontWeight="Bold"/>
                        <TextBlock x:Name="GameStatusText" Text="Aguardando o jogo..." Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#14382F" CornerRadius="12" Padding="14,8" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusBadge" Text="DESCONECTADO" Foreground="#68E3C7" FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <Border Background="#101418" BorderBrush="#252C32" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <TextBlock x:Name="TrainerStatusText" Text="Os recursos serão habilitados quando o personagem for localizado no mundo do jogo."
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                    <Button Content="Reanalisar memória" Style="{StaticResource DiagnosticButton}" Click="Reprobe_Click" Margin="0,0,10,0"/>
                    <Button Content="Copiar diagnóstico" Style="{StaticResource DiagnosticButton}" Click="CopyDiagnostic_Click"/>
                </StackPanel>

                <ItemsControl x:Name="SectionsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Margin="0,0,0,18" Padding="22">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                    <ItemsControl ItemsSource="{Binding Features}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,10">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,20,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" Style="{StaticResource TrainerToggle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                              Tag="{Binding Id}" IsEnabled="{Binding IsAvailable}" Checked="FeatureToggle_Checked" Unchecked="FeatureToggle_Unchecked"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
